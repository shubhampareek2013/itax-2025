---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Contact" canonicalPath="/contact">
  <div class="wrap">
    <div class="page-head" style="padding-top:24px">
      <div class="eyebrow">Contact</div>
      <h1 style="margin-top:8px">Contact</h1>
      <p>Spotted an error or an outdated provision? Tell us.</p>
    </div>
    <div class="prose"><p>Please report errors through the issues page of the project repository on GitHub, or by the contact details the site owner adds here.</p></div>
  </div>
</Layout>
