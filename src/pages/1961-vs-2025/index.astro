---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";
const m = JSON.parse(fs.readFileSync(path.join(process.cwd(), "content", "mapping", "mapping.json"), "utf-8"));
const rows = [
  ...m.terms.map((t) => ({ ...t, kind: "Term" })),
  ...m.sections.map((s) => ({ ...s, kind: "Section" }))
];
const label = { "same substance": "Same substance", modified: "Modified", renumbered: "Renumbered", "new provision": "New", removed: "Removed", uncertain: "Uncertain" };
---
<Layout title="1961 Act vs 2025 Act — verified mapping" canonicalPath="/1961-vs-2025">
  <style>
    .map { display: grid; gap: 12px; margin-top: 26px; }
    .mrow { display: grid; grid-template-columns: 90px 1fr 30px 1fr; gap: 14px; align-items: center; padding: 20px 24px; }
    .mrow .arrow { color: var(--accent); text-align: center; font-size: 20px; }
    .mrow small { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--text-2); }
    .mrow p { grid-column: 2 / -1; margin: 0; color: var(--text-2); font-size: 14px; }
    .mrow.hide { display: none; }
    @media (max-width: 700px) { .mrow { grid-template-columns: 1fr; } .mrow p { grid-column: 1; } .mrow .arrow { transform: rotate(90deg); } }
  </style>
  <div class="wrap">
    <div class="page-head" style="padding-top:24px">
      <div class="eyebrow">Mapping</div>
      <h1 style="margin-top:8px">1961 Act → 2025 Act</h1>
      <p>Only verified mappings appear here. A change in numbering is never treated as a change in substance.</p>
    </div>
    <div class="filters" style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="chip on" data-f="">All</button>
      <button class="chip" data-f="Term">Terms</button>
      <button class="chip" data-f="Section">Sections</button>
    </div>
    <div class="map" id="map">
      {rows.map((r) => (
        <div class="card mrow" data-kind={r.kind}>
          <div><span class="tag law">{label[r.status] || r.status}</span></div>
          <div><small>1961 Act · {r.kind}</small><b>{r.old}</b></div>
          <div class="arrow">→</div>
          <div><small>2025 Act</small><b>{r.new}</b></div>
          <p>{r.note}{r.article && <> <a href={`/income-tax-act-2025/section/${r.article}`}>Full explanation →</a></>}</p>
        </div>
      ))}
    </div>
  </div>
  <script is:inline>
    document.querySelectorAll("[data-f]").forEach(function (c) {
      c.addEventListener("click", function () {
        document.querySelectorAll("[data-f]").forEach(function (x) { x.classList.toggle("on", x === c); });
        document.querySelectorAll("#map .mrow").forEach(function (r) { r.classList.toggle("hide", c.dataset.f && r.dataset.kind !== c.dataset.f); });
      });
    });
  </script>
</Layout>
