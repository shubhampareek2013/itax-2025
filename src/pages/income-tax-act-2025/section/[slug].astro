---
import Layout from "../../../layouts/Layout.astro";
import { getPageItems, loadArticleBySlug, loadQueue, loadSource, loadAmendments, loadStudy } from "../../../lib/content.mjs";
import { extractFootnotes } from "../../../lib/footnotes.mjs";
import { esc, renderHunks } from "../../../lib/render.mjs";
import { marked } from "marked";

export function getStaticPaths() {
  return getPageItems().map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const OFFICIAL_PDF = "https://www.incometaxindia.gov.in/documents/d/guest/income_tax_act_2025_as_amended_by_fa_act_2026-pdf";
const article = loadArticleBySlug(item.slug);
const fm = article?.frontmatter || {};
const official = loadSource(item.id);
const queue = loadQueue();
const amendments = loadAmendments().filter((a) => a.section_id === item.id);
const notes = extractFootnotes(official);
const study = loadStudy(item.id);

const TYPES = {
  "Official Provision": ["Law", "law"], "In Simple Language": ["Explanation", "exp"], "Key Points": ["Explanation", "exp"],
  "Who Does This Apply To?": ["Explanation", "exp"], "Conditions": ["Explanation", "exp"], "Exceptions": ["Explanation", "exp"],
  "Practical Example": ["Explanation", "exp"], "Related Provisions": ["Links", "ai"], "Rules": ["Law", "law"],
  "CBDT Material": ["Official guidance", "guid"], "Case Law": ["Case law", "case"], "1961 vs 2025": ["Comparison", "exp"],
  "Practical Notes": ["AI-assisted", "ai"], "Sources": ["Sources", "ai"]
};
const slugify = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const sections = [];

// 1. Official text (verbatim from the Income Tax Department PDF — never AI-written)
if (official) {
  const paras = [];
  for (const line of official.split("\n")) {
    const l = line.trim(); if (!l) continue;
    if (!paras.length || /^\((\d+|[a-z]{1,4}|[A-Z]{1,3})\)/.test(l) || /^TABLE\b/.test(l)) paras.push(l);
    else paras[paras.length - 1] += " " + l;
  }
  const long = official.length > 5000;
  sections.push({ heading: "Official Text", id: "official-text", type: ["Law", "law"], html:
    `<p class="muted" style="font-size:14px;margin-top:0">Copied from the Income Tax Department's consolidated text of the Act (as amended by the Finance Act, 2026). Tables and footnotes may lose their layout here — <a href="${OFFICIAL_PDF}">the official PDF</a> is authoritative.</p>` +
    `<details ${long ? "" : "open"}><summary style="cursor:pointer;color:var(--accent);margin-bottom:12px">${long ? "Show the full official text" : "Official text"}</summary>` +
    paras.map((t) => `<p style="font-size:16px">${esc(t)}</p>`).join("") + `</details>` });
}

// 2. Amendments detected by the daily check (highlighted) + notes printed in the official text
if (amendments.length) {
  const html = amendments.map((a) => `
    <div style="margin-bottom:26px">
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><span class="tag guid">${a.kind}</span><b>Detected ${a.date_detected}</b><span class="muted" style="font-size:14px">+${a.added_words} / −${a.removed_words} words</span></div>
      ${renderHunks(a.hunks)}
      ${a.commentary ? `<div class="commentary">${marked.parse(a.commentary)}</div>` : `<p class="muted" style="font-size:14px">${a.commentary_status === "withheld" ? esc(a.commentary_note || "Commentary withheld.") : "Commentary is being prepared."}</p>`}
    </div>`).join("");
  sections.push({ heading: "Amendments since publication", id: "amendments", type: ["Amendment", "guid"], html: `<p class="legend"><del>removed</del> <ins>added</ins> — exact wording changes found by comparing the official Act with the previous version.</p>${html}` });
}
if (notes.length) {
  sections.push({ heading: "Amendment notes in the official text", id: "amendment-notes", type: ["Official notes", "guid"], html:
    `<p class="muted" style="font-size:14px;margin-top:0">Footnotes printed in the official Act for this section (extracted automatically — check the PDF for the exact layout).</p>` +
    `<ul>${notes.map((n) => `<li><b>${n.kind[0].toUpperCase() + n.kind.slice(1)}</b>${n.wef ? ` w.e.f. ${esc(n.wef)}` : ""} — ${esc(n.text)}</li>`).join("")}</ul>` });
}

// 2b. Study guide: commentary, worked example, MCQs, mnemonics (Gemini Pro, checked against the official text)
if (study) {
  const stale = study.stale ? `<p class="banner"><b>This section was amended after this study guide was written.</b> It will be refreshed automatically; rely on the official text and the highlighted amendment meanwhile.</p>` : "";
  sections.push({ heading: "Commentary", id: "commentary", type: ["AI-assisted", "ai"], html:
    stale + `<p class="muted" style="font-size:14px;margin-top:0">Written by Gemini from the official text above and checked against it. Not statutory text or legal advice.</p>` + marked.parse(study.commentary) });
  const ex = study.example;
  sections.push({ heading: "Worked example", id: "example", type: ["Explanation", "exp"], html:
    `<p class="banner" style="background:var(--accent-soft);border-color:transparent"><b>Assumptions (illustrative only):</b> ${esc(ex.assumptions)}</p>` +
    `<p><b>Scenario.</b> ${esc(ex.scenario)}</p><p><b>Walkthrough.</b> ${esc(ex.walkthrough)}</p><p><b>Takeaway.</b> ${esc(ex.takeaway)}</p>` });
  const q = study.mcqs.map((m, i) => `<div class="mcq" data-answer="${m.answer}"><p><b>Q${i + 1}.</b> ${esc(m.question)}</p>` +
    m.options.map((o, k) => `<button type="button" class="opt" data-i="${k}"><span class="ltr">${"ABCD"[k]}</span>${esc(o)}</button>`).join("") +
    `<div class="exp" hidden><b>Answer: ${"ABCD"[m.answer]}.</b> ${esc(m.explanation)}</div></div>`).join("");
  sections.push({ heading: "Test yourself", id: "test-yourself", type: ["Practice", "case"], html:
    `<p class="muted" style="font-size:14px;margin-top:0">Answer from the official text above. Tap an option to check it.</p>${q}<p class="score" id="score" aria-live="polite"></p>` });
  if (study.mnemonics.length) {
    sections.push({ heading: "Memory aids", id: "memory-aids", type: ["Mnemonic", "case"], html:
      study.mnemonics.map((m) => `<div class="mnemo"><div class="dev">${esc(m.device)}</div><ul>${m.stands_for.map((x) => `<li><b>${esc(x.letter)}</b> — ${esc(x.meaning)}</li>`).join("")}</ul><p class="muted" style="margin:6px 0 0;font-size:15px">${esc(m.tip || "")}</p></div>`).join("") +
      `<p class="muted" style="font-size:13px">Memory aids help you recall the parts of a section; the official text is what counts.</p>` });
  }
}

// 3. AI-assisted explanation (only if one has been published)
if (article) {
  for (const part of article.body.split(/^## /m).slice(1)) {
    const nl = part.indexOf("\n");
    const heading = part.slice(0, nl).trim();
    const body = part.slice(nl + 1).replace(/\n---\s*[\s\S]*$/, "").trim();
    sections.push({ heading, id: slugify(heading), type: TYPES[heading] || ["Note", "ai"], html: marked.parse(body) });
  }
  const refNums = [...new Set([...official.matchAll(/\bsections?\s+(\d{1,3})\b/gi)].map((m) => Number(m[1])))]
    .filter((n) => n !== Number(item.section) && n >= 1 && n <= 536).sort((a, b) => a - b);
  if (refNums.length) {
    const chips = refNums.map((n) => {
      const it = queue.items.find((i) => Number(i.section) === n);
      if (!it) return `<span class="chip" style="cursor:default">Section ${n}</span>`;
      const label = `Section ${n} — ${esc(it.title.length > 40 ? it.title.slice(0, 38) + "…" : it.title)}`;
      return `<a class="chip" href="/income-tax-act-2025/section/${it.slug}" title="${esc(it.title)}">${label}</a>`;
    }).join(" ");
    const at = sections.findIndex((x) => x.heading === "Related Provisions");
    const block = { heading: "Cross-references", id: "cross-references", type: ["Links", "ai"], html: `<p class="muted" style="font-size:14px;margin-top:0">Sections mentioned in the official text of this section.</p><div style="display:flex;flex-wrap:wrap;gap:8px">${chips}</div>` };
    if (at >= 0) sections.splice(at + 1, 0, block); else sections.push(block);
  }
} else if (!study) {
  sections.push({ heading: "Explanation", id: "explanation", type: ["Explanation", "exp"], html:
    `<p>A plain-language explanation of this section has not been published yet. The official text above is complete as of the last check.</p>` });
}

const title = fm.title || `Section ${item.section} — ${item.title} | Income-tax Act, 2025`;
const description = fm.description || `Official text of Section ${item.section} (${item.title}) of the Income-tax Act, 2025, with any amendments highlighted.`;
const verified = fm.lastVerified || item.last_verified;
---
<Layout title={title} description={description} canonicalPath={`/income-tax-act-2025/section/${item.slug}`} ogType="article" wide>
  <style is:global>
        .hunk { font-size: 15px; line-height: 1.7; padding: 14px 16px; border-radius: 14px; background: var(--bg-2); margin: 10px 0; }
    .hunk del { background: rgba(255,59,48,.14); color: #c4271c; text-decoration: line-through; padding: 0 2px; border-radius: 3px; }
    .hunk ins { background: rgba(52,199,89,.18); color: #1a7f37; text-decoration: none; padding: 0 2px; border-radius: 3px; font-weight: 500; }
    .hunk .gap { color: var(--text-2); }
    :root[data-theme="dark"] .hunk del { color: #ff8a80; } :root[data-theme="dark"] .hunk ins { color: #6be08a; }
    .legend { font-size: 13px; color: var(--text-2); } .legend del { background: rgba(255,59,48,.14); padding: 0 4px; border-radius: 3px; } .legend ins { background: rgba(52,199,89,.18); padding: 0 4px; border-radius: 3px; text-decoration: none; }
    #progress { position: fixed; top: 52px; left: 0; height: 3px; width: 0; background: linear-gradient(90deg, var(--accent), var(--accent-2)); z-index: 60; }
    .ahead { padding: 64px 0 28px; }
    .ahead h1 { font-size: clamp(34px, 5.5vw, 58px); font-weight: 700; max-width: 860px; }
    .ahead .crumb { font-size: 14px; margin-bottom: 18px; }
    .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
    .layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 56px; align-items: start; }
    .toc { position: sticky; top: 84px; font-size: 14px; }
    .toc b { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--text-2); margin-bottom: 10px; }
    .toc a { display: block; padding: 6px 12px; color: var(--text-2); border-left: 2px solid var(--line); transition: .2s; }
    .toc a:hover { color: var(--text); text-decoration: none; }
    .toc a.on { color: var(--accent); border-left-color: var(--accent); font-weight: 500; }
    .blockx { background: var(--card); border: 1px solid var(--line); border-radius: 24px; padding: 34px 38px; margin-bottom: 20px; scroll-margin-top: 80px; }
    .blockx h2 { font-size: 26px; font-weight: 700; margin: 12px 0 14px; }
    .blockx.law { border-left: 4px solid var(--accent); }
    .blockx.guid { border-left: 4px solid var(--warn); }
    .blockx.ai { background: var(--bg-2); }
    .blockx.notes { border: 1px dashed var(--line); }
    .blockx p, .blockx li { font-size: 17px; }
    .blockx ul, .blockx ol { padding-left: 22px; } .blockx li { margin: 6px 0; }
    .blockx table { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
    .blockx th, .blockx td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .blockx th { color: var(--text-2); font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; }
    .blockx blockquote { margin: 16px 0; padding: 14px 18px; border-radius: 14px; background: var(--accent-soft); border: 0; font-size: 15px; }
    .commentary { border-top: 1px solid var(--line); margin-top: 8px; padding-top: 4px; }
    .commentary p, .commentary li { font-size: 16px; }
    .banner { border-radius: 16px; padding: 14px 18px; margin: 0 0 20px; font-size: 15px; background: rgba(178,80,0,.1); border: 1px solid rgba(178,80,0,.3); }
    .mcq { padding: 18px 0; border-bottom: 1px solid var(--line); } .mcq:last-of-type { border-bottom: 0; }
    .opt { display: flex; gap: 12px; align-items: flex-start; width: 100%; text-align: left; font: inherit; font-size: 16px; color: var(--text); background: var(--bg); border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; margin: 8px 0; cursor: pointer; transition: .2s; }
    .opt:hover:not(:disabled) { border-color: var(--accent); }
    .opt .ltr { font-weight: 700; color: var(--accent); min-width: 18px; }
    .opt.right { background: rgba(52,199,89,.16); border-color: #34c759; } .opt.wrong { background: rgba(255,59,48,.12); border-color: #ff3b30; }
    .exp { background: var(--bg-2); border-radius: 14px; padding: 12px 16px; margin-top: 8px; font-size: 15px; }
    .score { font-weight: 600; margin: 14px 0 0; }
    .mnemo { background: var(--bg-2); border-radius: 18px; padding: 20px 24px; margin: 12px 0; } .mnemo .dev { font-size: 30px; font-weight: 800; letter-spacing: .04em; color: var(--accent); } .mnemo ul { list-style: none; padding: 0; margin: 10px 0 0; } .mnemo li { font-size: 16px; }
    .disc { font-size: 13px; color: var(--text-2); margin: 6px 0 0; }
    @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .toc { display: none; } .blockx { padding: 24px 22px; } }
  </style>

  <div id="progress"></div>
  <div class="wrap">
    <div class="ahead">
      <div class="crumb"><a href="/income-tax-act-2025">Income-tax Act, 2025</a> <span class="muted">›</span> <span class="muted">{item.chapter}</span></div>
      <div class="eyebrow">Section {item.section}</div>
      <h1 style="margin-top:8px">{item.title}</h1>
      <div class="meta">
        <span class="chip">{item.act}</span>
        <span class="chip">{item.chapter}</span>
        {verified && <span class="chip">Checked {verified}</span>}
        {amendments.length > 0 && <a class="chip on" href="#amendments">Amended {amendments[0].date_detected}</a>}
      </div>
    </div>

    <div class="layout">
      <aside class="toc" id="toc">
        <b>On this page</b>
        {sections.map((s) => <a href={`#${s.id}`}>{s.heading}</a>)}
      </aside>
      <article>
        {article && item.stale && <div class="banner"><b>This section was amended after the explanation below was written.</b> Rely on the official text and the highlighted amendment; the explanation may be out of date.</div>}
        {sections.map((s) => (
          <section id={s.id} class={`blockx ${s.type[1]} ${s.heading === "Practical Notes" ? "notes" : ""}`}>
            <span class={`tag ${s.type[1]}`}>{s.type[0]}</span>
            <h2>{s.heading}</h2>
            <Fragment set:html={s.html} />
          </section>
        ))}
        <p class="disc">Educational content, not legal advice. The official Act and Rules prevail. See the <a href="/disclaimer">disclaimer</a>.</p>
      </article>
    </div>
  </div>

  <script is:inline>
    (function () {
      var qs = document.querySelectorAll(".mcq"), got = 0, done = 0, sc = document.getElementById("score");
      qs.forEach(function (q) {
        q.querySelectorAll(".opt").forEach(function (b) {
          b.addEventListener("click", function () {
            var ans = Number(q.dataset.answer), pick = Number(b.dataset.i);
            q.querySelectorAll(".opt").forEach(function (o) { o.disabled = true; if (Number(o.dataset.i) === ans) o.classList.add("right"); });
            if (pick !== ans) b.classList.add("wrong"); else got++;
            q.querySelector(".exp").hidden = false; done++;
            if (sc) sc.textContent = "Score: " + got + " / " + qs.length + (done === qs.length ? " — done" : "");
          });
        });
      });
    })();
    var bar = document.getElementById("progress");
    var links = [].slice.call(document.querySelectorAll("#toc a"));
    var secs = links.map(function (a) { return document.querySelector(a.getAttribute("href")); });
    function onScroll() {
      var h = document.documentElement, max = h.scrollHeight - h.clientHeight;
      bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + "%";
      var cur = 0;
      secs.forEach(function (s, i) { if (s && s.getBoundingClientRect().top < 140) cur = i; });
      links.forEach(function (a, i) { a.classList.toggle("on", i === cur); });
    }
    addEventListener("scroll", onScroll, { passive: true }); onScroll();
  </script>
</Layout>
