---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { loadQueue, getPageItems, hasSource, loadAmendments } from "../lib/content.mjs";

const queue = loadQueue();
const published = getPageItems().sort((a, b) => Number(a.section) - Number(b.section));
const amendCount = loadAmendments().length;
const pending = queue.items.length - published.length;
const chapters = [...new Set(queue.items.map((i) => i.chapter))].map((c) => ({
  name: c,
  total: queue.items.filter((i) => i.chapter === c).length,
  done: queue.items.filter((i) => i.chapter === c && (hasSource(i.id) || i.status === "published")).length
}));
const topics = [...new Set(queue.items.map((i) => i.category))];
const mapping = JSON.parse(fs.readFileSync(path.join(process.cwd(), "content", "mapping", "mapping.json"), "utf-8"));
const pairs = [...mapping.terms, ...mapping.sections];
---
<Layout title="Income-tax Act, 2025 — clear, section-by-section guide" canonicalPath="/" wide>
  <style>
    .hero { position: relative; overflow: hidden; text-align: center; padding: 96px 0 72px; }
    .hero::before { content: ""; position: absolute; inset: -20% -10% auto -10%; height: 90%; z-index: -1;
      background: radial-gradient(600px 300px at 20% 30%, rgba(0,113,227,.18), transparent 70%),
                  radial-gradient(520px 300px at 80% 20%, rgba(94,92,230,.16), transparent 70%); }
    .hero h1 { font-size: clamp(44px, 8.5vw, 88px); font-weight: 800; letter-spacing: -0.04em; }
    .grad { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .hero p.sub { font-size: clamp(19px, 2.4vw, 26px); color: var(--text-2); max-width: 720px; margin: 22px auto 34px; line-height: 1.35; }
    .bigsearch { display: flex; align-items: center; gap: 12px; width: min(560px, 100%); margin: 0 auto; padding: 16px 22px; border-radius: 980px; border: 1px solid var(--line); background: var(--card); box-shadow: var(--shadow); color: var(--text-2); font: inherit; font-size: 18px; cursor: pointer; transition: .25s; }
    .bigsearch:hover { box-shadow: var(--shadow-h); border-color: var(--accent); transform: translateY(-2px); }
    .stats { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 26px; }
    section.blk { padding: 56px 0; }
    section.blk > .wrap > h2 { font-size: clamp(28px, 4vw, 40px); font-weight: 700; margin-bottom: 8px; }
    .lead { color: var(--text-2); font-size: 19px; margin: 0 0 28px; max-width: 640px; }
    .item h3 { font-size: 21px; font-weight: 600; margin: 10px 0 6px; }
    .item p { margin: 0; color: var(--text-2); font-size: 15px; }
    .bar { height: 6px; border-radius: 6px; background: var(--bg-2); overflow: hidden; margin-top: 14px; }
    .bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-2)); border-radius: 6px; }
    .finder { background: var(--bg-2); border-radius: 32px; padding: 44px; }
    .finder input { width: 100%; padding: 15px 20px; font: inherit; font-size: 18px; border-radius: 14px; border: 1px solid var(--line); background: var(--card); color: var(--text); outline: 0; margin-bottom: 18px; }
    .finder input:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
    .pair { display: grid; grid-template-columns: 1fr 34px 1fr; gap: 12px; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 16px 20px; margin-bottom: 10px; }
    .pair .arrow { color: var(--accent); font-size: 20px; text-align: center; }
    .pair small { display: block; color: var(--text-2); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    .pair b { font-weight: 600; }
    .pair p { grid-column: 1 / -1; margin: 4px 0 0; color: var(--text-2); font-size: 14px; }
    .pair.hide { display: none; }
    @media (max-width: 600px) { .finder { padding: 24px; } .pair { grid-template-columns: 1fr; } .pair .arrow { transform: rotate(90deg); } }
  </style>

  <section class="hero">
    <div class="wrap">
      <div class="eyebrow reveal">Income-tax Act, 2025 · in force from 1 April 2026</div>
      <h1 class="reveal" style="margin-top:14px">Tax law,<br /><span class="grad">made clear.</span></h1>
      <p class="sub reveal">Every provision explained in plain language — with the official source, practical examples, related rules and the 1961 comparison. Section by section, in the order of the Act.</p>
      <button class="bigsearch reveal" data-open-search><span>⌕</span><span style="flex:1;text-align:left">Search sections, terms, topics…</span><span class="kbd">Ctrl K</span></button>
      <div class="stats reveal">
        <span class="chip">{published.length} sections online</span>
        <span class="chip">{amendCount} amendments tracked</span>
      </div>
    </div>
  </section>

  <section class="blk">
    <div class="wrap">
      <h2 class="reveal">Start reading</h2>
      <p class="lead reveal">Fresh explanations, each traced back to the official text.</p>
      <div class="grid g3">
        {published.slice(0, 6).map((i) => (
          <a class="card item reveal" href={`/income-tax-act-2025/section/${i.slug}`}>
            <span class="tag law">Section {i.section}</span>
            <h3>{i.title}</h3>
            <p>{i.chapter}</p>
          </a>
        ))}
        {published.length === 0 && <div class="card">The Act data is being loaded.</div>}
      </div>
      <p style="margin-top:22px"><a href="/income-tax-act-2025">Browse all sections →</a></p>
    </div>
  </section>

  <section class="blk">
    <div class="wrap">
      <div class="finder reveal">
        <div class="eyebrow">1961 → 2025 quick finder</div>
        <h2 style="font-size:clamp(26px,3.6vw,36px);margin:8px 0 18px">What did it become?</h2>
        <input id="finder" type="search" placeholder="Try “previous year” or “section 4”…" />
        <div id="pairs">
          {pairs.map((p) => (
            <div class="pair" data-k={`${p.old} ${p.new}`.toLowerCase()}>
              <div><small>1961 Act</small><b>{p.old}</b></div>
              <div class="arrow">→</div>
              <div><small>2025 Act</small><b>{p.new}</b></div>
              <p>{p.note}{p.article && <> <a href={`/income-tax-act-2025/section/${p.article}`}>Read the full explanation →</a></>}</p>
            </div>
          ))}
        </div>
        <p class="muted" style="font-size:13px;margin:14px 0 0">Only verified mappings appear here; the list grows with every published provision.</p>
      </div>
    </div>
  </section>

  <section class="blk">
    <div class="wrap">
      <h2 class="reveal">Browse by chapter</h2>
      <p class="lead reveal">Coverage builds up chapter by chapter, in a fixed order.</p>
      <div class="grid g3">
        {chapters.map((c) => (
          <div class="card item reveal">
            <h3>{c.name}</h3>
            <p>{c.done} of {c.total} sections online</p>
            <div class="bar"><i style={`width:${Math.round((c.done / c.total) * 100)}%`}></i></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="blk">
    <div class="wrap">
      <h2 class="reveal">Browse by topic</h2>
      <div class="reveal" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">
        {topics.map((t) => <a class="chip" href={`/income-tax-act-2025?topic=${encodeURIComponent(t)}`}>{t}</a>)}
      </div>
    </div>
  </section>

  <section class="blk">
    <div class="wrap">
      <h2 class="reveal">Tools & references</h2>
      <div class="grid g4" style="margin-top:24px">
        <a class="card item reveal" href="/1961-vs-2025"><h3>1961 vs 2025</h3><p>Provision-by-provision mapping.</p></a>
        <a class="card item reveal" href="/case-law"><h3>Case law</h3><p>Verified judgments by section.</p></a>
        <a class="card item reveal" href="/cbdt-circulars"><h3>CBDT material</h3><p>Circulars and notifications.</p></a>
        <a class="card item reveal" href="/tax-calculators"><h3>Calculators</h3><p>Deterministic, never AI-computed.</p></a>
      </div>
    </div>
  </section>

  <script is:inline>
    var f = document.getElementById("finder");
    if (f) f.addEventListener("input", function () {
      var q = f.value.trim().toLowerCase();
      document.querySelectorAll("#pairs .pair").forEach(function (p) {
        p.classList.toggle("hide", q && p.getAttribute("data-k").indexOf(q) === -1);
      });
    });
  </script>
</Layout>
