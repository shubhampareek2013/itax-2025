---
export interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  wide?: boolean;
}
const {
  title,
  description = "Indian Income-tax Act 2025 & Rules 2026 — section-wise explanations, CBDT material, case law and 1961 vs 2025 comparisons.",
  canonicalPath = "/",
  ogType = "website",
  wide = false
} = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") || "";
const canonical = `${site}${canonicalPath}`;
const path = Astro.url.pathname;
const nav = [
  ["Tax Hub", "/tax-hub"],
  ["Act 2025", "/income-tax-act-2025"],
  ["Amendments", "/amendments"],
  ["Rules 2026", "/income-tax-rules-2026"],
  ["1961 → 2025", "/1961-vs-2025"],
  ["Case law", "/case-law"],
  ["CBDT", "/cbdt-circulars"],
  ["Calculators", "/tax-calculators"]
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="theme-color" content="#fbfbfd" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Latest updates" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      var t = localStorage.getItem("theme");
      if (t) document.documentElement.setAttribute("data-theme", t);
      document.documentElement.classList.add("js");
    })();
  </script>
  <style is:global>
    :root {
      --bg: #fbfbfd; --bg-2: #f5f5f7; --card: #ffffff; --text: #1d1d1f; --text-2: #6e6e73;
      --line: rgba(0,0,0,.09); --accent: #0071e3; --accent-2: #5e5ce6; --accent-soft: rgba(0,113,227,.09);
      --ok: #248a3d; --warn: #b25000; --shadow: 0 1px 2px rgba(0,0,0,.04), 0 8px 30px rgba(0,0,0,.06);
      --shadow-h: 0 2px 4px rgba(0,0,0,.05), 0 18px 44px rgba(0,0,0,.12);
      --glass: rgba(251,251,253,.72);
      --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    }
    :root[data-theme="dark"] {
      --bg: #000; --bg-2: #0d0d0f; --card: #161618; --text: #f5f5f7; --text-2: #a1a1a6;
      --line: rgba(255,255,255,.12); --accent: #2997ff; --accent-2: #7d7aff; --accent-soft: rgba(41,151,255,.14);
      --ok: #30d158; --warn: #ff9f0a; --shadow: 0 1px 2px rgba(0,0,0,.4); --shadow-h: 0 18px 44px rgba(0,0,0,.6);
      --glass: rgba(0,0,0,.66);
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #000; --bg-2: #0d0d0f; --card: #161618; --text: #f5f5f7; --text-2: #a1a1a6;
        --line: rgba(255,255,255,.12); --accent: #2997ff; --accent-2: #7d7aff; --accent-soft: rgba(41,151,255,.14);
        --ok: #30d158; --warn: #ff9f0a; --shadow: 0 1px 2px rgba(0,0,0,.4); --shadow-h: 0 18px 44px rgba(0,0,0,.6);
        --glass: rgba(0,0,0,.66);
      }
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body {
      margin: 0; background: var(--bg); color: var(--text); font-family: var(--font);
      font-size: 17px; line-height: 1.47; letter-spacing: -0.011em; -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    h1, h2, h3 { letter-spacing: -0.025em; line-height: 1.12; margin: 0; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
    .wrap.narrow { max-width: 780px; }

    /* Nav */
    header.site {
      position: sticky; top: 0; z-index: 50; background: var(--glass);
      backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
      border-bottom: 1px solid var(--line);
    }
    .nav { display: flex; align-items: center; height: 52px; gap: 8px; }
    .brand { font-weight: 600; font-size: 17px; color: var(--text); display: flex; align-items: center; gap: 9px; margin-right: 12px; white-space: nowrap; }
    .brand:hover { text-decoration: none; }
    .brand .mark { width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; color: #fff; font-size: 14px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
    .links { display: flex; gap: 2px; flex: 1; overflow-x: auto; scrollbar-width: none; }
    .links::-webkit-scrollbar { display: none; }
    .links a { color: var(--text-2); font-size: 14px; padding: 6px 11px; border-radius: 980px; white-space: nowrap; transition: .2s; }
    .links a:hover { color: var(--text); background: var(--accent-soft); text-decoration: none; }
    .links a.on { color: var(--text); background: var(--bg-2); font-weight: 500; }
    .icon-btn { border: 0; background: transparent; color: var(--text-2); cursor: pointer; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-size: 16px; transition: .2s; }
    .icon-btn:hover { background: var(--accent-soft); color: var(--text); }
    .search-btn { display: flex; align-items: center; gap: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text-2); border-radius: 980px; padding: 6px 12px; font: inherit; font-size: 14px; cursor: pointer; transition: .2s; }
    .search-btn:hover { border-color: var(--accent); color: var(--text); }
    .kbd { font-family: var(--mono); font-size: 11px; border: 1px solid var(--line); border-radius: 5px; padding: 1px 5px; background: var(--bg-2); }
    @media (max-width: 720px) { .search-btn span.lbl, .search-btn .kbd { display: none; } .brand span.t { display: none; } }

    main { padding-bottom: 80px; }
    main.pad { padding-top: 48px; }

    /* Buttons / chips / cards */
    .btn { display: inline-flex; align-items: center; gap: 8px; background: var(--accent); color: #fff; padding: 11px 22px; border-radius: 980px; font-size: 17px; border: 0; cursor: pointer; font-family: inherit; transition: .2s; }
    .btn:hover { filter: brightness(1.08); text-decoration: none; transform: scale(1.02); }
    .btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
    .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; padding: 6px 13px; border-radius: 980px; background: var(--bg-2); color: var(--text); border: 1px solid var(--line); cursor: pointer; font-family: inherit; transition: .2s; }
    .chip:hover { border-color: var(--accent); }
    .chip.on { background: var(--accent); border-color: var(--accent); color: #fff; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 26px; box-shadow: var(--shadow); transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s; display: block; color: var(--text); }
    a.card:hover { transform: translateY(-4px); box-shadow: var(--shadow-h); text-decoration: none; }
    .eyebrow { font-size: 13px; font-weight: 600; letter-spacing: .02em; color: var(--accent); text-transform: uppercase; }
    .muted { color: var(--text-2); }
    .grid { display: grid; gap: 18px; }
    .g2 { grid-template-columns: repeat(2, 1fr); } .g3 { grid-template-columns: repeat(3, 1fr); } .g4 { grid-template-columns: repeat(4, 1fr); }
    @media (max-width: 900px) { .g3, .g4 { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .g2, .g3, .g4 { grid-template-columns: 1fr; } }
    .tag { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; padding: 3px 9px; border-radius: 980px; background: var(--accent-soft); color: var(--accent); }
    .tag.law { background: rgba(0,113,227,.12); color: var(--accent); }
    .tag.exp { background: rgba(36,138,61,.13); color: var(--ok); }
    .tag.guid { background: rgba(178,80,0,.13); color: var(--warn); }
    .tag.case { background: rgba(94,92,230,.14); color: var(--accent-2); }
    .tag.ai { background: rgba(142,142,147,.18); color: var(--text-2); }

    /* Page headers for simple pages */
    .page-head { padding: 72px 0 36px; }
    .page-head h1 { font-size: clamp(36px, 6vw, 56px); font-weight: 700; }
    .page-head p { font-size: 21px; color: var(--text-2); max-width: 680px; margin: 14px 0 0; }
    .prose { max-width: 720px; }
    .prose p, .prose li { color: var(--text); }

    /* Reveal */
    .js .reveal { opacity: 0; transform: translateY(22px); transition: opacity .8s cubic-bezier(.2,.8,.2,1), transform .8s cubic-bezier(.2,.8,.2,1); }
    .js .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .js .reveal { opacity: 1; transform: none; transition: none; } html { scroll-behavior: auto; } }

    footer.site { border-top: 1px solid var(--line); background: var(--bg-2); padding: 36px 0; font-size: 13px; color: var(--text-2); }
    footer.site .cols { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    footer.site a { color: var(--text-2); margin-right: 16px; }

    /* Command palette */
    #palette { position: fixed; inset: 0; z-index: 100; display: none; background: rgba(0,0,0,.4); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    #palette.open { display: block; animation: fade .18s ease; }
    @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
    .pal { max-width: 640px; margin: 11vh auto 0; background: var(--card); border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 30px 80px rgba(0,0,0,.35); overflow: hidden; animation: pop .22s cubic-bezier(.2,.8,.2,1); }
    @keyframes pop { from { transform: scale(.97) translateY(-8px); opacity: 0; } to { transform: none; opacity: 1; } }
    .pal input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 20px; padding: 20px 22px; border-bottom: 1px solid var(--line); }
    .pal ul { list-style: none; margin: 0; padding: 8px; max-height: 50vh; overflow: auto; }
    .pal li a { display: block; padding: 11px 14px; border-radius: 12px; color: var(--text); }
    .pal li a small { display: block; color: var(--text-2); font-size: 13px; }
    .pal li a:hover, .pal li a.sel { background: var(--accent-soft); text-decoration: none; }
    .pal .empty { padding: 22px; color: var(--text-2); text-align: center; }
    .pal .hint { padding: 10px 18px; font-size: 12px; color: var(--text-2); border-top: 1px solid var(--line); display: flex; gap: 14px; }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap nav">
      <a class="brand" href="/"><span class="mark">§</span><span class="t">Income-tax Act 2025</span></a>
      <nav class="links" aria-label="Main">
        {nav.map(([label, href]) => <a href={href} class={path.startsWith(href) ? "on" : ""}>{label}</a>)}
      </nav>
      <button class="search-btn" id="open-search" aria-label="Search"><span>⌕</span><span class="lbl">Search</span><span class="kbd">Ctrl K</span></button>
      <button class="icon-btn" id="theme" aria-label="Toggle dark mode"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg></button>
    </div>
  </header>

  <main class={wide ? "" : "pad"}><slot /></main>

  <footer class="site">
    <div class="wrap cols">
      <div>Educational reference — not legal or tax advice. The official Act, Rules and CBDT material always prevail.</div>
      <div><a href="/about">About</a><a href="/disclaimer">Disclaimer</a><a href="/privacy-policy">Privacy</a><a href="/contact">Contact</a><a href="/rss.xml">RSS</a></div>
    </div>
  </footer>

  <div id="palette" role="dialog" aria-modal="true" aria-label="Search">
    <div class="pal">
      <input id="pal-input" type="search" placeholder="Search sections, topics, terms…" autocomplete="off" />
      <ul id="pal-list"></ul>
      <div class="hint"><span>↑↓ navigate</span><span>↵ open</span><span>esc close</span></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      document.getElementById("theme").addEventListener("click", function () {
        var dark = root.getAttribute("data-theme") === "dark" ||
          (!root.getAttribute("data-theme") && matchMedia("(prefers-color-scheme: dark)").matches);
        var next = dark ? "light" : "dark";
        root.setAttribute("data-theme", next); localStorage.setItem("theme", next);
      });

      // scroll reveal
      var els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
        }, { threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      } else { els.forEach(function (el) { el.classList.add("in"); }); }

      // command palette
      var pal = document.getElementById("palette"), input = document.getElementById("pal-input"), list = document.getElementById("pal-list");
      var data = null, sel = 0, shown = [];
      function load() {
        if (data) return Promise.resolve();
        return fetch("/search-index.json").then(function (r) { return r.json(); }).then(function (d) { data = d; }).catch(function () { data = []; });
      }
      function render() {
        var q = input.value.trim().toLowerCase(), terms = q.split(/\s+/).filter(Boolean);
        shown = (data || []).filter(function (i) {
          var hay = (i.title + " " + (i.section || "") + " " + (i.tags || []).join(" ") + " " + (i.description || "") + " " + (i.kind || "")).toLowerCase();
          return terms.every(function (t) { return hay.indexOf(t) > -1; });
        }).slice(0, 8);
        list.innerHTML = ""; sel = 0;
        if (!shown.length) { var e = document.createElement("div"); e.className = "empty"; e.textContent = q ? "No matches yet — try another word." : "Start typing to search."; list.appendChild(e); return; }
        shown.forEach(function (i, idx) {
          var li = document.createElement("li"), a = document.createElement("a"), s = document.createElement("small");
          a.href = i.url; a.textContent = (i.section ? "Section " + i.section + " — " : "") + i.title;
          s.textContent = i.description || i.kind || ""; a.appendChild(s);
          if (idx === 0) a.classList.add("sel");
          li.appendChild(a); list.appendChild(li);
        });
      }
      function open() { pal.classList.add("open"); input.value = ""; load().then(render); setTimeout(function () { input.focus(); }, 30); }
      function close() { pal.classList.remove("open"); }
      function move(d) {
        var items = list.querySelectorAll("a"); if (!items.length) return;
        items[sel].classList.remove("sel"); sel = (sel + d + items.length) % items.length;
        items[sel].classList.add("sel"); items[sel].scrollIntoView({ block: "nearest" });
      }
      document.getElementById("open-search").addEventListener("click", open);
      document.querySelectorAll("[data-open-search]").forEach(function (b) { b.addEventListener("click", open); });
      pal.addEventListener("click", function (e) { if (e.target === pal) close(); });
      input.addEventListener("input", render);
      document.addEventListener("keydown", function (e) {
        var k = e.key.toLowerCase();
        if ((e.ctrlKey || e.metaKey) && k === "k") { e.preventDefault(); pal.classList.contains("open") ? close() : open(); }
        else if (k === "/" && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); open(); }
        else if (pal.classList.contains("open")) {
          if (k === "escape") close();
          else if (k === "arrowdown") { e.preventDefault(); move(1); }
          else if (k === "arrowup") { e.preventDefault(); move(-1); }
          else if (k === "enter") { var items = list.querySelectorAll("a"); if (items[sel]) location.href = items[sel].href; }
        }
      });
    })();
  </script>
</body>
</html>
