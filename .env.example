# Copy to .env for local runs of the pipeline scripts (node scripts/run-pipeline.mjs).
# In GitHub Actions these come from repo Secrets/Variables instead — see README.md.

# Which AI provider the pipeline uses: "claude" | "gemini" | "manual"
AI_PROVIDER=gemini

# Required if AI_PROVIDER=gemini (free tier available via aistudio.google.com — no card needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required if AI_PROVIDER=claude (paid; console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Your production domain once you have one (used for canonical URLs, sitemap, RSS).
# Leave as-is to use the Cloudflare Pages default *.pages.dev domain.
SITE_URL=https://example-itax.pages.dev
